# Database (Required)
DATABASE_URL="file:./dev.db"
# Untuk production gunakan Turso (gratis):
# DATABASE_URL="libsql://your-database.turso.io"

# ====================
# VIDEO HOSTING OPTIONS (Pilih salah satu atau semua)
# ====================

# 1. TELEGRAM BOT (RECOMMENDED - Free, 2GB per file)
# Cara setup:
# 1. Buat bot di @BotFather
# 2. Ambil token bot
# 3. Buat private channel, tambahkan bot sebagai admin
# 4. Kirim pesan ke channel, forward ke @userinfobot untuk dapat chat_id
TELEGRAM_BOT_TOKEN="your_bot_token_here"
TELEGRAM_CHAT_ID="your_chat_id_here"

# 2. GITHUB RELEASES (RECOMMENDED untuk video >50MB - Free, unlimited, 2GB/file)
# Cara setup:
# 1. Buat Personal Access Token: https://github.com/settings/tokens (scope: repo)
# 2. Buat repo PUBLIC bernama bebas, misal: linguastream-videos
# 3. Format repo: "username/repo-name"
# 4. Repo HARUS public agar player video bisa streaming tanpa login
GITHUB_TOKEN="ghp_your_token_here"
GITHUB_REPO="username/linguastream-videos"

# 3. INTERNET ARCHIVE (Free, unlimited, public)
# Cara setup:
# 1. Daftar di archive.org
# 2. Buat API keys di: https://archive.org/account/s3.php
INTERNET_ARCHIVE_ACCESS_KEY="your_access_key"
INTERNET_ARCHIVE_SECRET_KEY="your_secret_key"

# 4. VERCEL BLOB (Free tier: 1GB)
# Auto-configured jika deploy di Vercel
# Manual setup: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN="vercel_blob_token"

# ====================
# OPTIONAL
# ====================

# NextAuth (jika ingin authentication)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"
